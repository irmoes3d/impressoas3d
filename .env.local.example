# Copie para .env.local e preencha com as credenciais do seu projeto Supabase
# (Project Settings > API). NUNCA commite .env.local nem cole a service_role
# key fora de um arquivo de ambiente local/servidor.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypassa RLS. Usada só em scripts/seed.ts e Server Actions do admin.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. O webhook falha fechado se qualquer uma estiver ausente.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Server-only. API transacional do Resend; o domínio precisa estar verificado.
RESEND_API_KEY=
ORDER_EMAIL_FROM=2 Irmaos Impressoes 3D <no-reply@seudominio.com.br>

# Número usado nos botões de WhatsApp (formato internacional, só dígitos)
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999
